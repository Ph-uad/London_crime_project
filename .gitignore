# ---- R ----
.Rhistory
.RData
.Rproj.user
*.Rproj.user

# Apache Derby writes this wherever a Spark session starts. The retired
# experimental scripts still do; catch it at any depth.
derby.log
**/derby.log
metastore_db/
spark-warehouse/

# ---- Data ----
# Raw source data is never committed: it is large, and SOURCES.md carries the
# recipe to rebuild it.
data/raw/

# Raw crime CSVs must live in data/raw/crime/ ONLY. This rule stays as a
# backstop in case a copy reappears here, but note that data/processed/ is a
# pipeline output directory : anything the pipeline can overwrite belongs
# nowhere near your only copy of the source data.
data/processed/crime/

# Retired Spark intermediates (3.7 GB and 3.9 GB). The current pipeline does
# not produce these; the rules remain so an experimental/ run cannot commit them.
data/processed/crime.csv
data/processed/crime_by_borough.csv

# ---- Node / Next.js ----
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
/out/
/build
/coverage
web/test-results/
web/playwright-report/
*.tsbuildinfo
next-env.d.ts

# ---- Misc ----
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env*
